# 앱 관리 포트 (management.server.port). 앱이 이 PC에서 뜨면 host.docker.internal
APP_METRICS_TARGET=host.docker.internal:8081
# spring.application.name 과 맞춘다
APP_NAME=backend
APP_ENV=local
# 앱의 LOG_FILE이 있는 폴더
APP_LOG_DIR=../../backend/logs

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# 다른 스택과 포트가 겹치면 바꾼다
GRAFANA_PORT=3300
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
ALLOY_UI_PORT=12345
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
