# backend/.env (선택) - 로컬에서 기본값을 바꾸고 싶을 때만 만든다.
#   cp .env.example .env
# 로컬 실행에 꼭 넣어야 하는 값은 없다. DB는 compose.yaml의 PostgreSQL이 자동으로 붙는다.
#
# 이 파일은 Spring이 properties 파일로 읽는다 (application.yml 의 spring.config.import).
#   - 아래 대문자 변수는 application.yml 의 ${...} 자리에 그대로 들어간다
#   - Spring 표준 설정은 점 표기로 쓴다 (예: spring.datasource.url). SPRING_DATASOURCE_URL 형식은
#     OS 환경변수에서만 동작하고 이 파일에서는 동작하지 않는다
#   - 같은 값을 OS 환경변수로도 주면 환경변수가 이긴다
# 전체 설정 설명: docs/configuration.md

# --- 서버 ---
# Actuator 관리 포트 (/actuator/health, /actuator/prometheus)
#MANAGEMENT_PORT=8081
# Swagger UI, /v3/api-docs 노출 여부. 운영에서는 false
#API_DOCS_ENABLED=true

# --- 모니터링 (infra/observability 를 띄웠을 때) ---
#APP_ENV=local
#OTLP_TRACING_ENABLED=true
#OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
#TRACING_SAMPLING_PROBABILITY=1.0
# JSON 로그 파일. Alloy가 읽는다
#LOG_FILE=logs/backend.log
# 콘솔 로그를 JSON으로 (logstash 또는 ecs). Docker, k8s 에서 수집기로 보낼 때
#LOG_CONSOLE_FORMAT=logstash

# --- 외부 DB를 쓸 때 (compose.yaml 의 PostgreSQL 대신) ---
#spring.docker.compose.enabled=false
#spring.datasource.url=jdbc:postgresql://localhost:5432/app
#spring.datasource.username=app
#spring.datasource.password=app
